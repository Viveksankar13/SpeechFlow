# =============================================================
# SpeechFlow — .gitignore
# =============================================================

# ── Environment files (NEVER commit these) ──
.env
.env.local
.env.production
.env.*.local
backend/.env
frontend/.env.local
frontend/.env.production

# ── Python ──
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/
*.so
*.whl

# ── Virtual environments ──
venv/
.venv/
env/
ENV/
.virtualenv/

# ── Alembic ──
# Keep versions/ tracked — migrations are code
alembic/versions/__pycache__/

# ── Pytest ──
.pytest_cache/
.coverage
htmlcov/
*.xml

# ── Node / npm ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Next.js build output ──
frontend/.next/
frontend/out/

# ── IDEs ──
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Docker ──
# (Dockerfiles are tracked — these are runtime artifacts)
*.tar

# ── Logs ──
*.log
logs/

# ── OS ──
.DS_Store
desktop.ini
