# ============================================================
# SpeechFlow Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
# Supabase: use Session Pooler (port 5432) for persistent FastAPI service
# Local dev: use docker-compose postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/speechflow

# --- Google Gemini ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live
GEMINI_API_VERSION=v1beta

# --- Anonymous Session Cookies ---
SESSION_COOKIE_NAME=speechflow_session
SESSION_TTL_DAYS=30
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false
# Use "lax" for local dev, "none" for cross-origin production
COOKIE_SAMESITE=lax

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000

# --- App ---
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development
